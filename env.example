# FREEVERSE environment variables. Names and safe placeholders only. Copy to .env and fill in real values locally.
# Never commit .env. Never put a service-role key, database password or AI key in browser code: they are read only by the server.

NODE_ENV=development            # development | test | production
HOST=127.0.0.1                  # production defaults to 0.0.0.0
PORT=5173
PUBLIC_ORIGIN=http://localhost:5173
LOG_LEVEL=info                  # silent | error | warn | info | debug

# ---- Database ----
# Production REQUIRES PostgreSQL. SQLite is for local development and tests only and is refused in production.
DATABASE_URL=                   # e.g. postgres://USER:PASSWORD@HOST:5432/DBNAME  (leave empty in dev to use SQLite)
DATABASE_SSL=                   # true/false (defaults to true in production)
SQLITE_PATH=.data/freeverse.sqlite

# ---- Authentication ----
# Leave SUPABASE_URL empty for the honest local demo sign-in (passwords are NOT checked; dev only).
AUTH_PROVIDER=                  # dev | supabase (auto: supabase when SUPABASE_URL is set)
SUPABASE_URL=                   # https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=              # public anon key
SUPABASE_SERVICE_ROLE_KEY=      # SERVER ONLY. Never expose to the browser.
FOUNDER_EMAIL=                  # the account with this email receives the Founder role when it signs up

# ---- Media storage ----
STORAGE_DRIVER=local            # local | supabase
UPLOAD_DIR=.data/uploads
SUPABASE_STORAGE_BUCKET=freeverse-media
MEDIA_URL_SECRET=               # REQUIRED in production: a long random string used to sign media URLs

# ---- AI ----
AI_PROVIDER=                    # demo | anthropic (auto: anthropic when ANTHROPIC_API_KEY is set)
ANTHROPIC_API_KEY=              # SERVER ONLY
NOVA_MODEL=claude-sonnet-5-5
AI_DAILY_MESSAGE_CAP=60
NOVA_FLAG_RETENTION_DAYS=30     # how long safety-flagged Nova excerpts are kept (disclosed to members)

# ---- Behaviour ----
ANONYMOUS_POSTING_ENABLED=false # global switch, OFF by default. Communities opt in separately.
ENABLE_DEV_TOOLS=               # defaults to true outside production
SEED_DEMO_DATA=                 # defaults to true outside production; demo content is always labelled
STATIC_DIR=dist

# ---- Deployment (backend host behind the Vercel proxy) ----
TRUST_PROXY_HOPS=               # number of trusted proxies in front of the backend (Render: 1)
PROXY_SHARED_SECRET=            # same random value on Vercel and the backend; lets the backend trust the visitor IP the proxy forwards
ALLOW_EPHEMERAL_STORAGE=        # set to 1 ONLY to knowingly run production with local disk storage (files vanish on redeploy)

# ---- Vercel project settings (not read by the backend) ----
# BACKEND_URL=https://YOUR-BACKEND.onrender.com   # where api/[...path].mjs forwards /api/* requests
# PROXY_SHARED_SECRET=                            # same value as above
