{
  "name": "freeverse",
  "version": "0.5.0",
  "private": true,
  "description": "FREEVERSE Stage 2: trust-first platform for adults 18 and over (web). Server (Node + PostgreSQL/SQLite) and React client.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && tsx server/index.ts",
    "start:server": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "e2e:immersive": "node scripts/e2e-immersive.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "db:render": "node scripts/render-migrations.mjs",
    "db:migrate": "tsx server/cli/migrate.ts",
    "build:web": "node scripts/build.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:vercel": "node scripts/check-vercel.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "three": "0.186.1",
    "tsx": "4.23.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
